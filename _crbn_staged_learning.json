                                            33,
                                            76,
                                            183,
                                            55,
                                            105,
                                            182,
                                            86,
                                            35,
                                            108
                                        ],
                                        "e3_name": "crbn",
                                        "calculate_path": "data/fgfr4"
                                    },
                                    "transform": {
                                        "type": "sigmoid",
                                        "high": 0.5,
                                        "low": -0.8,
                                        "k": 0.2
